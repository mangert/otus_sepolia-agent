SEPOLIA_RPC_URL=https://your-sepolia-rpc.example

# Optional: IANA time zone used in answers about the current date and time.
TZ=Europe/Amsterdam

# Optional: path relative to the project working directory.
LLM_CONFIG_PATH=config/llm.config.json

# Required by the default Groq configuration.
GROQ_API_KEY=replace-with-your-groq-api-key

# Optional: required only when the local proxy is protected by a bearer token.
# OPENCODE_LLM_PROXY_TOKEN=replace-with-your-local-proxy-token

# Optional: outbound HTTP proxy. Use an HTTP or mixed v2Ray/Xray inbound, not SOCKS.
# For a local Node.js launch:
# HTTP_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10808
# For Docker on Linux, replace 10808 with the actual HTTP/mixed inbound port:
# HTTP_PROXY=http://host.docker.internal:10808
# HTTPS_PROXY=http://host.docker.internal:10808
# NO_PROXY=localhost,127.0.0.1,your-sepolia-rpc.example

RPC_TIMEOUT_MS=10000
RPC_MAX_RETRIES=2
RPC_MAX_LOG_BLOCK_RANGE=2000
RPC_MAX_BATCH_SIZE=20
